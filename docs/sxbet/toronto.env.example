# SX Bet Toronto TESTNET environment (template). Docs-only: nothing in this repository reads it yet.
# Copy to a file that is NOT committed. Leave secrets empty here. Never commit values.
# Completely separate from production: different process, different host, different database,
# different API key, different signing key. Never set these on the production Render service.
# Validated by signer/network_profile.check_toronto_env (tests/test_sxbet_network_profile.py).
# See docs/sxbet/testnet_toronto_readiness.md.

# Profile selector: the only accepted value here is "toronto".
SXBET_NETWORK_PROFILE=toronto
# Network name used by the existing intent/signer fields for Toronto.
SXBET_NETWORK=testnet

# Toronto API key, generated by the owner on toronto.sx.bet ("Testnet keys are network-specific").
# Distinct name from the production SXBET_API_KEY, which must NOT be present in this environment.
SXBET_TORONTO_API_KEY=

# Signer data directory (ledger/audit) of the testnet signer: absolute path, never the mainnet one.
SXBET_TORONTO_SIGNER_DATA_DIR=

# Testnet database (separate Neon project/branch). Production DATABASE_URL must NOT be present.
SXBET_TORONTO_DATABASE_URL=

# Explicit host allowlist: Toronto hosts only. Any mainnet host is refused by the validator.
SXBET_TORONTO_ALLOWED_HOSTS=api.toronto.sx.bet,realtime.toronto.sx.bet

# Forbidden in this environment (refused by the validator): SXBET_API_KEY, DATABASE_URL, RENDER,
# SXBET_LIVE_TRADING_FLAG, any SXBET_MAINNET_* variable, SXBET_NETWORK other than testnet.
# The testnet signing key is provided to the testnet signer process only, by the owner, out of band;
# it is never written in this file, in the repository, in GitHub secrets or on Render.
