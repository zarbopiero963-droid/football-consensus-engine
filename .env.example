# Copy to a file that is NOT committed (.env or staging/forebet/pilot48/var/api_key).
# Leave real values empty here. Never commit secrets.
BROWSER_USE_API_KEY=
DATABASE_URL=
# Set to 1 on the persistent Render runtime. When enabled, Neon write failures are fatal.
DATABASE_REQUIRED=0

MCP_PUBLIC_HOST=football-consensus-browser-bridge.onrender.com

# Single-user password shown only on the OAuth authorization page.
MCP_OAUTH_PASSWORD=

# Optional API-FOOTBALL v3 MCP module (docs/api_football/README.md). Disabled by default.
# The key is set only in the Render secret store by the owner.
APIFOOTBALL_ENABLED=false
APIFOOTBALL_API_KEY=
